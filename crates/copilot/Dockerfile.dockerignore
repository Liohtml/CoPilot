# Allowlist: only the Cargo workspace (and the Grafana dashboard templates
# copilot-grafana-dashboards embeds, the case report templates copilot-incidents
# embeds) is sent to the builder.
*
!Cargo.toml
!Cargo.lock
!rustfmt.toml
!clippy.toml
!crates/
!backend/app/connectors/grafana/dashboards/
!backend/app/incidents/templates/
crates/**/target/
