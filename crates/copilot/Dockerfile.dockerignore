# Allowlist: only the Cargo workspace (and the backend templates it embeds:
# copilot-grafana-dashboards' dashboards, copilot-integration-provisioning's
# collector files, Wazuh group configurations and worker stack, the case
# report templates copilot-incidents embeds) is sent to the builder.
*
!Cargo.toml
!Cargo.lock
!rustfmt.toml
!clippy.toml
!crates/
!backend/app/connectors/grafana/dashboards/
!backend/app/integrations/crowdstrike/templates/
!backend/app/integrations/defender_for_endpoint/templates/
!backend/app/integrations/bitdefender/templates/
!backend/app/customer_provisioning/templates/
!backend/app/connectors/portainer/templates/
!backend/app/incidents/templates/
crates/**/target/
