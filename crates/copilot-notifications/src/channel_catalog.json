    "webhook_url": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Webhook Url"
    }
   },
   "title": "TeamsConfig",
   "type": "object"
  },
  "supports_recipient_modes": [
   "static"
  ],
  "supports_internal_scope": true,
  "secret_fields": [
   "webhook_url"
  ],
  "template_formats": [
   "markdown",
   "text"
  ]
 }
]
